# Copy to .env and fill in your local values. .env is git-ignored.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yourpassword
# For Neo4j Aura, use the neo4j+s:// URI from the Aura console (TLS follows the scheme):
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# Set to enable the integration test (requires an empty database; leaves it empty):
# NEO4J_TEST_URI=bolt://localhost:7687
